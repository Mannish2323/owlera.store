# ====================================================================
# OWLERA E-COMMERCE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit production keys.
# ====================================================================

# 1. SUPABASE DATABASE & AUTHENTICATION
# Public Supabase project URL and anon public key (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Server-only secret service role key (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# 2. RAZORPAY PAYMENT GATEWAY
# Test Mode Key ID (starts with rzp_test_...) or Live Key ID (starts with rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Razorpay Webhook Secret (used to verify incoming capture/refund webhooks)
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# 3. SITE URL & STORE METADATA
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=OWLERA
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_WHATSAPP_NUMBER=916305630468
